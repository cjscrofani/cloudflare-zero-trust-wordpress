# Copy to .dev/.env and edit. Not committed.

# Hostname and URL for the test site.
# SITE_URL is written into the database on first install — change it before the
# first `.dev/bin/dev up`, or run `.dev/bin/dev destroy` first.
DEV_DOMAIN=cfzt.local
SITE_URL=https://cfzt.local

# WordPress admin account created on install.
ADMIN_USER=admin
ADMIN_PASS=admin
ADMIN_EMAIL=admin@example.test

# Cloudflare Tunnel token, for testing against a real public hostname.
# Zero Trust -> Networks -> Tunnels -> create -> point at http://wordpress:80
# TUNNEL_TOKEN=
